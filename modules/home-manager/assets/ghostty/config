# Ghostty Configuration
# Converted from Alacritty configuration

# Font Configuration
# Per MIGRATION.md D11 / adr.jsonl#6: the on-disk family is
# "Operator Mono * Nerd Font Complete" (the literal asterisk is part of
# the family name as patched by Nerd Fonts), not the older
# "OperatorMono Nerd Font Mono" string in the historical config.
font-family = Operator Mono * Nerd Font Complete
font-size = 14
font-family-bold = Operator Mono * Nerd Font Complete
font-style-bold = Medium
font-family-italic = Operator Mono * Nerd Font Complete
font-style-italic = Regular Italic

# Colors - Primary
background = 1d1f21
foreground = c5c8c6

# Color Rendering - for brighter, more vivid colors
alpha-blending = linear-corrected
window-colorspace = display-p3
bold-color = bright

# Colors - Normal (palette 0-7)
palette = 0=1d1f21
palette = 1=cc6666
palette = 2=b5bd68
palette = 3=f0c674
palette = 4=81a2be
palette = 5=b294bb
palette = 6=8abeb7
palette = 7=c5c8c6

# Colors - Bright (palette 8-15)
palette = 8=969896
palette = 9=cc6666
palette = 10=b5bd68
palette = 11=f0c674
palette = 12=81a2be
palette = 13=b294bb
palette = 14=8abeb7
palette = 15=ffffff

# Colors - Indexed (palette 16-21)
palette = 16=de935f
palette = 17=a3685a
palette = 18=282a2e
palette = 19=373b41
palette = 20=b4b7b4
palette = 21=e0e0e0

# Cursor
cursor-style = block
cursor-color = c5c8c6
cursor-text = 1d1f21

# Shell Integration - disable cursor changing to keep block cursor, and title to hide directory path
shell-integration-features = no-cursor, no-title

# Window Behavior
confirm-close-surface = false

# Environment
term = xterm-256color-italic

# Window
window-decoration = auto
background-opacity = 1.0
window-width = 180
window-height = 50
window-padding-x = 2
window-padding-y = 2

# splits
split-divider-color = ad95b8

# Mouse
mouse-hide-while-typing = false
mouse-scroll-multiplier = 3

# Scrollback
scrollback-limit = 320000000

# Selection
copy-on-select = false

# Keybindings - Window Management
keybind = cmd+n=new_window
keybind = cmd+h=ignore
keybind = cmd+q=quit
keybind = cmd+w=close_surface

# Keybindings - Clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+c=copy_to_clipboard

# Keybindings - Font Size
keybind = cmd+0=reset_font_size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1

# Keybindings - Command Palette
keybind = cmd+k=toggle_command_palette

# Keybindings - Clear (moved to cmd+shift+k)
keybind = cmd+shift+k=clear_screen

# Keybindings - Navigation (Alt key sequences)
keybind = alt+j=text:\x1bj
keybind = alt+k=text:\x1bk
keybind = alt+h=text:\x1bh
keybind = alt+l=text:\x1bl

# Keybindings - Special Keys
keybind = shift+enter=text:\n
keybind = shift+tab=text:\x1b[Z
keybind = backspace=text:\x7f
keybind = alt+backspace=text:\x1b\x7f

# Keybindings - Arrow Keys with modifiers
keybind = shift+left=text:\x1b[1;2D
keybind = ctrl+left=text:\x1b[1;5D
keybind = alt+left=text:\x1bb
keybind = shift+right=text:\x1b[1;2C
keybind = ctrl+right=text:\x1b[1;5C
keybind = alt+right=text:\x1bf
keybind = shift+up=text:\x1b[1;2A
keybind = ctrl+up=text:\x1b[1;5A
keybind = alt+up=text:\x1b[1;5A
keybind = shift+down=text:\x1b[1;2B
keybind = ctrl+down=text:\x1b[1;5B
keybind = alt+down=text:\x1b[1;5B

# Keybindings - Page Navigation
keybind = shift+page_up=text:\x1b[5;2~
keybind = ctrl+page_up=text:\x1b[5;5~
keybind = page_up=text:\x1b[5~
keybind = shift+page_down=text:\x1b[6;2~
keybind = ctrl+page_down=text:\x1b[6;5~
keybind = page_down=text:\x1b[6~

# Keybindings - Home/End
keybind = insert=text:\x1b[2~
keybind = delete=text:\x1b[3~

# Keybindings - Function Keys (F1-F12)
