// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
{
  // ------------ Extensions --------------
  "auto_install_extensions": {
    "actionscript": true,
    "caddyfile": true,
    "color-highlight": true,
    "comment": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "elisp": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "github-dark-default": true,
    "golangci-lint": true,
    "gotmpl": true,
    "graphql": true,
    "html": true,
    "java": true,
    "log": true,
    "mermaid": true,
    "nix": true,
    "php": true,
    "powershell": true,
    "prisma": true,
    "pylsp": true,
    "ruby": true,
    "ruff": true,
    "sql": true,
    "tailwind-theme": true,
    "terraform": true,
    "toml": true,
    "tomorrow-theme": true,
    "vhs": true,
    "xml": true,
  },
  // ------------ Font Size --------------
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "disabled_globs": [
      "/Volumes/*",
      "*.env",
      "*.env.sh",
      ".env",
      ".env.sh",
      "config.toml",
      "*.config.toml",
    ],
    "mode": "subtle",
  },
  "ui_font_size": 13.0,
  "buffer_font_size": 13.0,
  // ------------ Zed --------------
  "restore_on_startup": "last_session",
  "active_pane_modifiers": {
    "border_size": 0.8,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "cursor_blink": false,
  // Only show error on tab
  "tabs": {
    "show_diagnostics": "errors",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "active_line_width": 2,
    "line_width": 1,
  }, // Indentation, rainbow indentation
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc"],
  },
  "show_whitespaces": "all",
  "show_wrap_guides": true,
  "gutter": {
    "folds": false,
    "runnables": false,
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "project_panel": {
    "button": false,
    "dock": "right",
    "git_status": true,
    "show_diagnostics": "errors",
    "auto_reveal_entries": true,
    "indent_size": 10,
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "notification_panel": {
    "button": false,
    "dock": "left",
  },
  // Zed as the commit editor
  "terminal": {
    // "font_family": "FiraCode Nerd Font Mono",
    "env": {
      "EDITOR": "zed --wait",
    },
  },
  "unnecessary_code_fade": 0.75,
  // ------------ Format --------------
  "format_on_save": "on",
  "formatter": "auto",
  // ------------ Assistant --------------
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6-thinking-latest",
      "enable_thinking": false
    },
    "model_parameters": []
  },
  // ------------ LSP --------------
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path=stdout",
          "--issues-exit-code=1",
          "--show-stats=false",
        ],
      },
    },
    "rubocop": {
      "settings": {
        "use_bundler": false,
      },
      "initialization_options": {
        "safeAutocorrect": false,
      },
    },
    "solargraph": {
      "settings": {
        "use_bundler": false,
      },
      "initialization_options": {
        "diagnostics": true,
        "formatting": true,
      },
    },

    // "harper-ls": {
    //   "enable_lsp_tasks": false,
    //   "settings": {
    //     "harper-ls": {
    //       "userDictPath": "~/dict.txt",
    //       "fileDictPath": "~/.harper/",
    //       "diagnosticSeverity": "information", // hint, warning, error, information
    //       "linters": {
    //         "spell_check": true,
    //         "spelled_numbers": true,
    //         "an_a": true,
    //         "sentence_capitalization": true,
    //         "unclosed_quotes": true,
    //         "wrong_quotes": false,
    //         "long_sentences": true,
    //         "repeated_words": true,
    //         "spaces": true,
    //         "matcher": true,
    //         "correct_number_suffix": true,
    //         "number_suffix_capitalization": true,
    //         "multiple_sequential_pronouns": true,
    //         "linking_verbs": false,
    //         "avoid_curses": true,
    //         "terminating_conjunctions": true,
    //       },
    //       "codeActions": {
    //         "forceStable": true, // Force code actions to appear in "stable" positions
    //       },
    //       "code_actions": {
    //         "force_stable": true, // Force code actions to appear in "stable" positions
    //       },
    //     },
    //   },
    // },
  },
  // ------------ Languages --------------
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
    "Ruby": {
      // "language_servers": ["solargraph", "rubocop", "harper-ls", "!ruby-lsp"]
      "code_actions_on_format": {
        "format_on_save": true,
      },
      "language_servers": ["solargraph", "harper-ls", "!ruby-lsp"],
    },
    "Markdown": {
      // Prevent Zeta AI from completing anything in a Markdown file type
      "show_edit_predictions": false,
    },
    // code_action_on_format is the setting which tells Zed to automatically
    // apply code actions when formatting code.
    //
    // For TS/JS files using eslint this is equivalent to running eslint --fix
    //
    // https://zed.dev/docs/configuring-zed#code-actions-on-format
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.fixAll": true,
        "source.organizeImports": true,
      },
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true,
      },
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
  },
  // ------------ Vim --------------
  "vim_mode": true, // Vim Mode Enabled
  // ------------ Theme --------------
  //   PINK   = "#ad95b8" <- pink
  //   base0A = "#F0C674" <- bright orange
  //   base04 = "#B4B7B4"
  //   base07 = "#FFFFFF"
  //   base05 = "#C5C8C6"
  //   base0E = "#B294BB"
  //   base0D = "#81A2BE" <- darker blue
  //   base0C = "#8ABEB7" <- light blue
  //   base0B = "#B5BD68"
  //   base02 = "#373B41"
  //   base0F = "#A3685A"
  //   base03 = "#969896"
  //   base08 = "#CC6666" <- red
  //   base01 = "#282A2E"
  //   base00 = "#1D1F21"
  //   base09 = "#DE935F"
  //   base06 = "#E0E0E0" <- off white
  "theme": "Tomorrow Night",
  "experimental.theme_overrides": {
    "editor.document_highlight.read_background": "#0000",
    "editor.foreground": "#FFFFFFEF", // All Editor text (w/ opacity value)
    "text": "#FFFFFFCF", // Zed text not redered within an Editor (w/ opacity value)
    "text.muted": "#FFFFFFCF", // ProjectPanel text (w/ opacity value)
    "text.placeholder": "#FFFFFFCF",
    "tab_bar.background": "#0F0F0F",
    "tab.inactive_background": "#0F0F0F",
    "border.selected": "#ad95b8",
    "syntax": {
      "brakcet": {
        "color": "#ffff",
        "font_weight": 800,
      },
      "constant": {
        "color": "#CC6666",
      },
      "constant.builtin": {
        "color": "#CC6666",
      },
      "string": {
        "color": "#B5BD68",
      },
      "string_content": {
        "color": "#F0C674",
      },
      "boolean": {
        "color": "#F0C674",
      },
      "number": {
        "color": "#F0C674",
      },
      "punctuation.list_marker": {
        "color": "#F0C674",
      },
      "type": {
        "color": "#F0C674",
      },
      "typedef": {
        "color": "#F0C674",
      },
      "function": {
        "color": "#81A2BE",
      },
      "include": {
        "color": "null",
        "font_style": "italic",
      },
      "method": {
        "color": "#81A2BE",
      },
    },
    "editor.hover_line_number": "#F0C674",
    "editor.active_line_number": "#F0C674",
    "players": [
      {
        "cursor": "#AD95B8",
        "background": "#C5C8C6",
        "selection": "#373b41c0",
      },
      {
        "cursor": null,
        "background": null,
        "selection": null,
      },
    ],
  },
  // ------------ MISC --------------
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // ^ above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/report",
    "**/node_modules",
  ],
}
